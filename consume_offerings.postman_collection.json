							"            textField3: \"\",\r",
							"            amount: \"1\",\r",
							"            domain1: \"EDUCATION\",\r",
							"            domain2: \"EUROPE\",\r",
							"            domain3: \"UNIVERSITIES\",\r",
							"            country: \"GR\",\r",
							"            year: \"2025\",\r",
							"            description: \"Data transaction from IDS Provider to Consumer\",\r",
							"            content: pm.environment.get(\"createdArtifactURL\"),\r",
							"            content1: pm.environment.get(\"createdAgreementURL\"),\r",
							"            content2: pm.environment.get(\"createdArtifactDataUrl\"),\r",
							"            content3: \"\"\r",
							"        })\r",
							"    }\r",
							"}, function (err, res) {\r",
